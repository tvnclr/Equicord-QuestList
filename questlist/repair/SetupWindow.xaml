<Window x:Class="QuestListRepair.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="480" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Inter}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Icon="pack://application:,,,/Assets/QuestList.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid ClipToBounds="True">
            <Canvas IsHitTestVisible="False">
                <Ellipse Canvas.Left="-120" Canvas.Top="-140" Width="440" Height="440" Fill="#D93A42" Opacity="0.28" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Effect>
                        <BlurEffect Radius="110" RenderingBias="Performance" />
                    </Ellipse.Effect>
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Orb1Scale" />
                            <TranslateTransform x:Name="Orb1Move" />
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="470" Canvas.Top="260" Width="380" Height="380" Fill="#7A1E26" Opacity="0.55" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Effect>
                        <BlurEffect Radius="110" RenderingBias="Performance" />
                    </Ellipse.Effect>
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Orb2Scale" />
                            <TranslateTransform x:Name="Orb2Move" />
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="36">
                    <TextBlock x:Name="TitleText" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text2}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WinButton}" Click="Min_Click" AutomationProperties.Name="Minimize">
                            <Path Data="M0,0.5 H10" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Click="Close_Click" AutomationProperties.Name="Close">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="Pages" Margin="56,0,56,28">
                    <Grid x:Name="StartPage">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,20,0,0">
                            <Image Source="pack://application:,,,/Assets/symbol.png" Width="104" Height="104" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="QuestList" Style="{StaticResource Title}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock x:Name="Tagline" FontSize="15" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <Border Style="{StaticResource CardBorder}" Background="#DB27262F" Padding="16,14" Margin="0,24,0,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="12" Background="{StaticResource Elevated}" VerticalAlignment="Center">
                                        <ContentControl x:Name="QuestifyIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <CheckBox x:Name="QuestifySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" />
                                    <StackPanel Margin="12,0,16,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="QuestifyTitle" Style="{StaticResource Item}" />
                                        <TextBlock x:Name="QuestifySub" Style="{StaticResource Cap}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <DockPanel VerticalAlignment="Bottom">
                            <Button x:Name="InstallButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Height="48" Padding="32,0" FontSize="16" Click="Install_Click" />
                            <TextBlock Style="{StaticResource Cap}" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Run x:Name="LicensePre" /><Hyperlink NavigateUri="https://github.com/tvnclr/Equicord-QuestList/blob/main/LICENSE" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource AccentFg}"><Run x:Name="LicenseLink" /></Hyperlink><Run Text="." />
                            </TextBlock>
                        </DockPanel>
                    </Grid>

                    <StackPanel x:Name="ProgressPage" Visibility="Collapsed" Margin="0,16,0,0">
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/symbol.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ProgressTitle" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProgressSub" Style="{StaticResource Cap}" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,16,0,16">
                            <Border x:Name="ProgressTrack" Height="6" CornerRadius="3" Background="{StaticResource Elevated}" />
                            <Border x:Name="ProgressFill" Height="6" CornerRadius="3" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <Border Style="{StaticResource CardBorder}" Background="#DB27262F" Padding="0,4">
                            <StackPanel x:Name="StepsList" />
                        </Border>
                    </StackPanel>

                    <Grid x:Name="ResultPage" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" Margin="0,48,0,0">
                            <Border x:Name="ResultBadge" Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center">
                                <ContentControl x:Name="ResultIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="ResultTitle" Style="{StaticResource Title}" HorizontalAlignment="Center" Margin="0,20,0,0" />
                            <TextBlock x:Name="ResultBody" FontSize="15" Foreground="{StaticResource Text2}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
                            <Button x:Name="SecondaryButton" Style="{StaticResource Tonal}" Height="48" Padding="24,0" FontSize="15" Click="Secondary_Click" />
                            <Button x:Name="PrimaryButton" Style="{StaticResource Primary}" Height="48" Padding="32,0" FontSize="16" Margin="12,0,0,0" Click="Primary_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
